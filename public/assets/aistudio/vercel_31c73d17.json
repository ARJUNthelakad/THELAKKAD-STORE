{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist/client",
  "rewrites": [
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" },
    { "source": "/favicon.svg", "destination": "/favicon.svg" },
    { "source": "/images/(.*)", "destination": "/images/$1" }
  ]
}
